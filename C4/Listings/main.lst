  35   5                  password+=KeyNum%10;   //获取一位数
  36   5                  Count++;   //按下键盘的次数加一  
  37   5                }
  38   4              }
  39   3            LCD_ShowNum(2,1,password,5);    //LED1602更新显示
  40   3          }
  41   2          if(KeyNum==11)    //如果s11按键按下，接下来对输入的拆弹密码进行检验
  42   2          {
  43   3            if(password==12345)    //如果拆弹密码输入正确
  44   3            {
  45   4              LCD_ShowString(1,1,"        ");  //LED1602更新显示
  46   4              LCD_ShowString(2,1,"        ");   //更新显示
  47   4              Delay(1000);
  48   4              Delay(1000);
  49   4              Delay(1000);
  50   4              Delay(1000);
  51   4              LCD_ShowString(1,1,"success ");   //更新显示，炸弹成功拆除标志 
  52   4              Count=0;       //计次清零
  53   4              flag=1;
  54   4            }
